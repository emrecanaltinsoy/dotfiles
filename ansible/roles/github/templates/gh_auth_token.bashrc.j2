#!/usr/bin/env bash
# Export GH auth tokens if authenticated, prompt login if not

command -v gh >/dev/null 2>&1 || return 0

_gh_init() {
  # Fast check: look for auth file instead of running gh command
  local gh_hosts="${HOME}/.config/gh/hosts.yml"
  if [[ ! -f "${gh_hosts}" ]] || ! grep -q "oauth_token" "${gh_hosts}" 2>/dev/null; then
    # Not authenticated, show hint once per session
    local session_marker="/tmp/gh_login_hint_$$"
    if [[ ! -f "${session_marker}" ]]; then
      echo "💡 Tip: Run 'gh auth login' to authenticate GitHub CLI"
      touch "${session_marker}"
    fi
    return 0
  fi

  # Get token only when we know auth exists (still needed for export)
  local token
  token=$(gh auth token -h github.com 2>/dev/null)

  export GH_AUTH_TOKEN="${token}"
  export GH_ENTERPRISE_TOKEN="${token}"
  export GALAXY_GIT_TOKEN="${token}"
  export GH_IS_CONNECTED=true

  # One-time key setup (still uses a marker file, but just for keys)
  local marker="${HOME}/.cache/gh_connection/keys_configured"
  [[ -f "${marker}" ]] && return 0

  mkdir -p "${HOME}/.cache/gh_connection"

  # Export SSH key if not already on GitHub
  local pub_key="${HOME}/.ssh/{{ ssh_key_name }}.pub"
  if [[ -f "${pub_key}" ]]; then
    local fingerprint
    fingerprint=$(awk '{print $1,$2}' "${pub_key}")
    gh ssh-key list 2>/dev/null | grep -q "${fingerprint}" ||
      gh ssh-key add "${pub_key}" --title "$(uname -n) ssh key"
  fi

  touch "${marker}"
}

_gh_init
