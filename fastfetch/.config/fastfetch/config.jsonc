{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Ubuntu_small",
    "color": {
      "1": "red",
      "2": "white"
    }
  },
  "display": {
    "separator": " ",
    "color": "blue"
  },
  "modules": [
    "title",
    {
      "type": "kernel",
      "key": "\u001b[31m "
    },
    {
      "type": "uptime",
      "key": "\u001b[32m "
    },
    {
      "type": "packages",
      "key": "\u001b[33m "
    },
    {
      "type": "shell",
      "key": "\u001b[34m ",
      "showVersion": false,
      "showPath": false
    },
    {
      "type": "terminal",
      "key": "\u001b[35m "
    },
    {
      "type": "memory",
      "key": "\u001b[36m ",
      "showPercentage": true
    }
  ]
}
